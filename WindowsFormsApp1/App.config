<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <connectionStrings>
    <!-- Actualice la cadena con sus credenciales. Ejemplo: server=localhost;port=3306;database=rpg_journey;uid=root;pwd=contraseña; -->
    <add name="rpgDb" connectionString="server=localhost;port=3306;database=rpg_journey;uid=root;pwd=your_password;" providerName="MySql.Data.MySqlClient" />
  </connectionStrings>
  <appSettings>
    <!-- URL base de la API; cambie si la API se ejecuta en otro puerto o host -->
    <add key="ApiBaseUrl" value="http://localhost:5227/api/rpg" />
  </appSettings>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
  </startup>
</configuration>
